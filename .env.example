# ==============================================================================
# TaskFlow Environment Variables Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode: development | production
NODE_ENV=development

# JSON Web Token Secret Key for Authentication (Lectures 37-40)
# Obvious placeholder: set a secure, private secret string in your actual .env
JWT_SECRET=your_jwt_secret_key_placeholder_change_in_production

# JWT Expiration duration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# MongoDB Connection String (Lecture 41)
# Note: If MongoDB is not running or not provided, TaskFlow gracefully falls back
# to local data/tasks.json storage so the app works anywhere without installation!
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# File Upload Settings (Lectures 37-40 Multer)
MAX_FILE_SIZE_MB=2
UPLOAD_DIR=uploads
